DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ometus_db
SQL_ECHO=False

JWT_SECRET_KEY=change
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000

GROQ_API_KEY=your-groq-key
